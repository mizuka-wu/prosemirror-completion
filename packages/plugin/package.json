{
  "name": "@prosemirror-completion/plugin",
  "version": "0.0.8",
  "description": "Copilot-style text completion plugin for ProseMirror",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "license": "MIT",
  "keywords": [
    "prosemirror",
    "completion",
    "copilot",
    "ghost-text",
    "editor",
    "ai",
    "llm",
    "suggestion"
  ],
  "author": "ProseMirror Completion Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizuka-wu/prosemirror-completion.git"
  },
  "homepage": "https://mizuka-wu.github.io/prosemirror-completion/",
  "bugs": {
    "url": "https://github.com/mizuka-wu/prosemirror-completion/issues"
  },
  "scripts": {
    "build": "vite build && node ./scripts/postbuild.mjs",
    "lint": "eslint \"**/*.ts\""
  },
  "peerDependencies": {
    "prosemirror-model": "^1.19.4",
    "prosemirror-state": "^1.4.3",
    "prosemirror-transform": "^1.7.3",
    "prosemirror-view": "^1.33.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "prosemirror-model": "^1.19.4",
    "prosemirror-state": "^1.4.3",
    "prosemirror-transform": "^1.7.3",
    "prosemirror-view": "^1.33.3",
    "typescript": "5.5.4",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0"
  }
}